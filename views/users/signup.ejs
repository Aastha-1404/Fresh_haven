<% layout('layouts/boilerplates.ejs') %>

<main class="signup-page">
	<section class="signup-card" aria-labelledby="signup-title">
		<div class="signup-card-heading">
			<span class="signup-icon" aria-hidden="true"><i class="fa-solid fa-user-plus"></i></span>
			<p class="listings-eyebrow">Join Fresh Haven</p>
			<h1 id="signup-title">Create your account</h1>
			<p>Save your favorite stays and share places worth discovering.</p>
		</div>

		<form class="signup-form" method="POST" action="/users/signup" novalidate onsubmit="this.classList.add('was-validated'); return this.checkValidity();">
			<div class="signup-field">
				<label for="username">Username</label>
				<div class="signup-input-wrap">
					<i class="fa-regular fa-user" aria-hidden="true"></i>
					<input type="text" id="username" name="username" placeholder="Choose a username" minlength="3" maxlength="30" autocomplete="username" required>
				</div>
				<div class="invalid-feedback">Choose a username between 3 and 30 characters.</div>
			</div>

			<div class="signup-field">
				<label for="email">Email address</label>
				<div class="signup-input-wrap">
					<i class="fa-regular fa-envelope" aria-hidden="true"></i>
					<input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
				</div>
				<div class="invalid-feedback">Enter a valid email address.</div>
			</div>

			<div class="signup-field">
				<label for="password">Password</label>
				<div class="signup-input-wrap">
					<i class="fa-solid fa-lock" aria-hidden="true"></i>
					<input type="password" id="password" name="password" placeholder="Create a strong password" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,}" title="Use at least 8 characters with an uppercase letter, lowercase letter, number, and special character" autocomplete="new-password" required>
					<button class="password-toggle" type="button" aria-label="Show password" title="Show password" onclick="togglePassword('password', this)"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
				</div>
				<p class="signup-password-hint">Use 8+ characters with uppercase, lowercase, a number, and a special character.</p>
				<div class="invalid-feedback">Use a strong password with uppercase, lowercase, a number, and a special character.</div>
			</div>

			<div class="signup-field">
				<label for="confirmPassword">Confirm password</label>
				<div class="signup-input-wrap">
					<i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
					<input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter your password" minlength="8" autocomplete="new-password" oninput="this.setCustomValidity(this.value !== document.getElementById('password').value ? 'Passwords must match.' : '')" required>
					<button class="password-toggle" type="button" aria-label="Show password confirmation" title="Show password confirmation" onclick="togglePassword('confirmPassword', this)"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
				</div>
				<div class="invalid-feedback">Passwords must match.</div>
			</div>

			<button class="signup-submit" type="submit"><i class="fa-solid fa-arrow-right-to-bracket"></i> Create account</button>
		</form>

		<p class="signup-login-prompt">Already have an account? <a href="/users/login">Log in</a></p>
	</section>
</main>

<script>
	function togglePassword(inputId, button) {
		const input = document.getElementById(inputId);
		const isHidden = input.type === 'password';
		input.type = isHidden ? 'text' : 'password';
		button.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
		button.setAttribute('title', isHidden ? 'Hide password' : 'Show password');
		button.innerHTML = `<i class="fa-regular fa-eye${isHidden ? '-slash' : ''}" aria-hidden="true"></i>`;
	}
</script>
